# Database Configuration (Sibling-Safe Port 5436)
DB_USER=postgres
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=s_gates
DATABASE_URL=postgresql://postgres:replace-with-a-unique-database-password@db:5432/s_gates

# Security & JWT Configuration
APP_ENV=development
SECRET_KEY=replace-with-openssl-rand-hex-32-or-longer

# Default Seed Accounts
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
ENABLE_DEMO_ROLE_SWITCHER=false
SEED_DEMO_ASSESSMENTS=false

# ZIP Security Controls (PRD Section 11 & 35)
MAX_ZIP_SIZE_MB=50
MAX_EXPANDED_SIZE_MB=128
MAX_FILE_COUNT=5000
MAX_SCAN_SECONDS=120

# Evidence Vault & Integrations (PRD Section 24, 33, 36, 37)
EVIDENCE_VAULT_DIR=/app/evidence_vault
SHAREPOINT_VAULT_URL=https://example.invalid/sharepoint-vault
TEAMS_WEBHOOK_URL=https://example.invalid/teams-webhook
FRESHSERVICE_DOMAIN=example.invalid

# Frontend & CORS
ALLOWED_ORIGINS=http://localhost:3003,http://127.0.0.1:3003,http://localhost:3000,http://127.0.0.1:3000
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_URL=http://localhost:8003
